{% extends "base.html.j2" %}
{% from "_macros.html.j2" import badge, status_bar, source_list, logo %}
{% block title %}{{ agency.display }} · {{ cfg.site_title }}{% endblock %}
{% block description %}{{ agency.display }}'s SB 63 cost-saving commitments: {{ agency.total }} tracked recommendations, each with its status and primary sources.{% endblock %}
{% block main %}
<div class="rt-agency-head" style="--agency: {{ agency.color }}">
  <span class="rt-eyebrow"><a href="{{ base }}">Overview</a> / Agency</span>
  <h1>{{ logo(agency, "lg") }}<span>{{ agency.display }}</span></h1>
</div>
<p class="rt-lede">{{ agency.total }} recommendations from the SB 63 financial efficiency review are tracked for
  {{ agency.display }}. Most recent check: {{ agency.last_verified | date }}.</p>

{{ status_bar(agency.bar) }}
<ul class="rt-count-row" aria-label="Count by status">
  {% for s in statuses %}{% if agency.counts[s.key] %}
  <li>{{ badge(s.key) }} <strong>{{ agency.counts[s.key] }}</strong></li>
  {% endif %}{% endfor %}
</ul>
{% if target and (agency.counts["adopted"] or agency.counts["in_progress"]) %}
<p class="rt-meta">MTC's estimated completion date for {{ agency.display }}'s adopted strategies: {{ target.text }}
  (<a href="{{ cfg.pip_url }}">MTC Res. 4743</a>).</p>
{% endif %}

{% if agency.actions %}
<h2>Board actions</h2>
<ul class="rt-actions">
  {% for d, desc in agency.actions %}
  <li><span class="rt-actions-date">{% if d %}{{ d | date }}{% else %}Date not recorded{% endif %}</span> {{ desc }}</li>
  {% endfor %}
</ul>
{% endif %}

<h2 id="list-h">Recommendations</h2>
<form class="rt-filters" id="filters" hidden aria-controls="commitments">
  <div>
    <label for="f-phase">Phase</label>
    <select id="f-phase" name="phase">
      <option value="">All phases</option>
      {% for k, label in phases.items() %}<option value="{{ k }}">{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div>
    <label for="f-status">Status</label>
    <select id="f-status" name="status">
      <option value="">All statuses</option>
      {% for s in statuses %}<option value="{{ s.key }}">{{ s.label }}</option>{% endfor %}
    </select>
  </div>
  <p id="filter-count" class="rt-meta" aria-live="polite"></p>
</form>

<ol class="rt-list" id="commitments" aria-labelledby="list-h">
  {% for c in agency.rows %}
  <li class="rt-item" id="{{ c.id }}" data-phase="{{ c.phase_key }}" data-status="{{ c.skey }}">
    <details>
      <summary>
        <span class="rt-item-rec">{{ c.recommendation }}</span>
        <span class="rt-item-meta">
          {{ badge(c.skey) }}
          <span class="rt-tag">{{ c.phase_label }}</span>
          <span class="rt-tag">{{ c.category }}</span>
          <span class="rt-verified">Last verified {{ c.status_as_of | date }}</span>
        </span>
      </summary>
      <div class="rt-item-body">
        <dl class="rt-facts">
          <dt>Status</dt><dd>{{ badge(c.skey) }} as of {{ c.status_as_of | date }}</dd>
          <dt>Board action</dt>
          <dd>{% if c.board_action %}{% if c.board_action.date %}{{ c.board_action.date | date }}: {% else %}Date not recorded: {% endif %}{{ c.board_action.description }}{% else %}None recorded{% endif %}</dd>
          <dt>Required by</dt>
          <dd>{% if c.required_by_milestone %}{{ c.required_by_milestone.title }}: {{ c.required_by_milestone.deadline_text }} ({{ c.required_by_milestone.statute }}){% else %}{{ c.required_by | date }}{% endif %}</dd>
          {% if c.target_completion %}
          <dt>Target completion</dt><dd>{{ c.target_completion | date }} <span class="rt-cite">({{ c.target_completion_basis }})</span></dd>
          {% endif %}
          <dt>Estimated savings</dt><dd>{{ c.estimated_savings_usd | usd }} <span class="rt-cite">({{ c.savings_basis }})</span></dd>
          {% if c.notes %}<dt>Notes</dt><dd>{{ c.notes }}</dd>{% endif %}
          <dt>Sources</dt><dd>{{ source_list(c.sources) }}</dd>
          <dt>Entry ID</dt><dd><code>{{ c.id }}</code> · <a href="#{{ c.id }}">link to this entry</a></dd>
        </dl>
      </div>
    </details>
  </li>
  {% endfor %}
</ol>
<p class="rt-meta">Click or tap a recommendation to see its board action, sources, and notes.</p>
{% endblock %}
{% block scripts %}<script src="{{ base }}static/filter.js?v={{ ver }}" defer></script>{% endblock %}
